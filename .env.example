# Скопируй в .env (make делает это сам при первом запуске) и поменяй значения.
# .env в git не попадает.

# Пароль пользователя admin в Grafana (профиль history, http://127.0.0.1:3000).
GRAFANA_ADMIN_PASSWORD=change-me

# Часовой пояс, по которому считается «сегодня» (имя из базы tz).
CC_OVERLAY_TZ=Europe/Moscow

# Подсеть внутренней сети стека. Менять, только если 10.210.0.0/24 уже занята.
# CC_OVERLAY_SUBNET=10.210.0.0/24
