    {
      "type": "table",
      "title": "Топ сессий за период",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Сессии с наибольшей оценкой стоимости за выбранный период.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "topk(10, sum by (session_id) (last_over_time(claude_code_cost_usage_USD_total{job=~\"claude-code(-desktop)?\"}[$__range]) - (last_over_time(claude_code_cost_usage_USD_total{job=~\"claude-code(-desktop)?\"}[7d] offset $__range) or last_over_time(claude_code_cost_usage_USD_total{job=~\"claude-code(-desktop)?\"}[$__range]) * 0)) > 0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "session_id": "сессия",
              "Value": "≈$"
            }
          }
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "≈$",
            "desc": true
          }
        ]
      },
