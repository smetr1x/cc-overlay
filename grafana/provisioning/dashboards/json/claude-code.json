{
  "uid": "cc-overlay",
  "title": "Claude Code: расход",
  "description": "Расход токенов и стоимости Claude Code, лимиты подписки, события API. Дашборд из репозитория cc-overlay.",
  "tags": [
    "claude-code",
    "cc-overlay"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "stat",
      "title": "Токены за период",
      "description": "input + output + cacheCreation за выбранный период. Чтение кэша — отдельно: по объёму оно на порядок больше.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum (last_over_time(claude_code_token_usage_tokens_total{job=~\"claude-code(-desktop)?\", type!=\"cacheRead\"}[$__range]) - (last_over_time(claude_code_token_usage_tokens_total{job=~\"claude-code(-desktop)?\", type!=\"cacheRead\"}[7d] offset $__range) or last_over_time(claude_code_token_usage_tokens_total{job=~\"claude-code(-desktop)?\", type!=\"cacheRead\"}[$__range]) * 0))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "нет данных",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "id": 1
    },
